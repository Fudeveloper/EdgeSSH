# Copy to .dev.vars for local development.
CONNECT_TIMEOUT_MS=10000
# 只启用一种登录方式；生产由 Actions 自动填写 APP_ORIGIN 和 ADMIN_ACCOUNT_ID。
AUTH_PROVIDER=cloudflare
APP_ORIGIN=https://your-worker.example.workers.dev
ADMIN_ACCOUNT_ID=admin
# cloudflare 模式需要以下两项；github 模式不需要。
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-audience
# github 模式填写 OAuth App 和管理员数字 ID（生产由 GITHUB_ADMIN 用户名自动解析）。
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ADMIN_ID=
# ENCRYPTION_KEY 必须为 32 字节安全随机数的 Base64；本文件只用于本地开发，生产值在 Cloudflare Worker 控制台中保存为 Secret。
